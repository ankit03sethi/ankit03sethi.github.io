<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<title>Reports &middot; Cursive Analyst</title>
<style>
  *{box-sizing:border-box}
  body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;background:#f8fafc;color:#0f172a}
  header{background:#fff;border-bottom:1px solid #e5e7eb;padding:12px 20px;display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}
  .brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:inherit}
  .brand-name{font-size:17px;font-weight:800;letter-spacing:-.2px}
  .nav-sub{font-size:11px;color:#64748b;margin-top:2px}
  .back-link{display:inline-flex;align-items:center;gap:6px;color:#1f6feb;text-decoration:none;font-size:14px;font-weight:700}
  main{max-width:1100px;margin:0 auto;padding:28px 20px 80px}
  h1{font-size:24px;font-weight:800;margin:0 0 4px}
  .sub{color:#64748b;font-size:14px;margin:0 0 24px}
  .card{background:#fff;border:1px solid #e5e7eb;border-radius:16px;padding:22px;margin-bottom:18px;box-shadow:0 4px 18px rgba(15,23,42,.05)}
  .card.locked{opacity:.62}
  .card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap}
  .card h2{font-size:18px;font-weight:800;margin:0 0 4px}
  .card p.desc{margin:0;color:#64748b;font-size:13.5px;max-width:620px}
  .pill{font-size:11px;font-weight:800;padding:4px 10px;border-radius:999px;white-space:nowrap}
  .pill.ok{background:#ecfdf5;color:#047857}
  .pill.need{background:#fef3c7;color:#92400e}
  .kpis{display:flex;gap:26px;flex-wrap:wrap;margin:18px 0 4px}
  .kpi .n{font-size:26px;font-weight:800;letter-spacing:-.5px}
  .kpi .l{font-size:11.5px;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:.4px}
  .kpi .n.warn{color:#b45309}
  .controls{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:16px 0 0}
  select,button{font:inherit;padding:8px 12px;border-radius:9px;border:1px solid #cbd5e1;background:#fff}
  button.primary{background:#1f6feb;color:#fff;border-color:#1f6feb;font-weight:700;cursor:pointer}
  button.ghost{cursor:pointer;font-weight:700;color:#334155}
  table{width:100%;border-collapse:collapse;font-size:13px;margin-top:14px}
  th,td{text-align:left;padding:8px 10px;border-bottom:1px solid #f1f5f9;white-space:nowrap}
  th{font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:#64748b;font-weight:800;background:#f8fafc;position:sticky;top:0}
  td.num,th.num{text-align:right}
  .scroll{max-height:460px;overflow:auto;border:1px solid #eef2f7;border-radius:10px;margin-top:12px}
  .muted{color:#94a3b8}
  .note{font-size:12.5px;color:#64748b;background:#f8fafc;border-left:3px solid #cbd5e1;padding:10px 12px;border-radius:0 8px 8px 0;margin-top:14px;line-height:1.55}
  .empty{padding:26px;text-align:center;color:#64748b;font-size:14px}
  .spin{display:inline-block;width:14px;height:14px;border:2px solid #cbd5e1;border-top-color:#1f6feb;border-radius:50%;animation:sp .7s linear infinite;vertical-align:-2px}
  @keyframes sp{to{transform:rotate(360deg)}}
</style>
</head>
<body>

<header>
  <a href="/home/" class="brand">
    <div>
      <div class="brand-name">Cursive Analyst</div>
      <div class="nav-sub">Reports &middot; build 2026-08-30a</div>
    </div>
  </a>
  <a href="/analyst/" class="back-link">&larr; Back</a>
</header>

<main>
  <h1>Reports</h1>
  <p class="sub">Each report turns on by itself once the data it needs has been uploaded. Nothing to configure.</p>

  <!-- ============ 1. Unpaid delivered orders ============ -->
  <div class="card locked" id="cardUnpaid">
    <div class="card-head">
      <div>
        <h2>Unpaid delivered orders</h2>
        <p class="desc">Orders the marketplace confirms it delivered, with no settlement line anywhere against them.
          Anything delivered recently is excluded &mdash; marketplaces pay days later, so a recent order
          <em>should</em> be unpaid. What is left is money past its window.</p>
      </div>
      <span class="pill need" id="pillUnpaid">checking&hellip;</span>
    </div>

    <div id="unpaidBody" style="display:none">
      <div class="controls">
        <label style="font-size:13px;color:#475569;font-weight:700">Older than</label>
        <select id="grace">
          <option value="15">15 days</option>
          <option value="20" selected>20 days</option>
          <option value="30">30 days</option>
          <option value="45">45 days</option>
        </select>
        <button class="primary" id="runUnpaid">Run</button>
        <button class="ghost" id="csvUnpaid">Download CSV</button>
        <span id="unpaidStatus" class="muted" style="font-size:12.5px"></span>
      </div>

      <div class="kpis" id="unpaidKpis"></div>
      <div id="unpaidByPlat"></div>
      <div class="scroll" id="unpaidTableWrap" style="display:none"><table id="unpaidTable"></table></div>

      <div class="note" id="unpaidNote"></div>
    </div>
  </div>

  <!-- ============ placeholders, in the order they will be built ============ -->
  <div class="card locked">
    <div class="card-head">
      <div><h2>Payout reconciliation</h2>
        <p class="desc">Income less advertising and fees, per company, platform and month &mdash; against the money that actually reached the bank.</p></div>
      <span class="pill need">next</span>
    </div>
  </div>
  <div class="card locked">
    <div class="card-head">
      <div><h2>Returns &amp; RTO</h2>
        <p class="desc">Return rate, RTO rate, return freight and reasons &mdash; keeping customer returns and RTO apart, because only one of them takes money back.</p></div>
      <span class="pill need">planned</span>
    </div>
  </div>
  <div class="card locked">
    <div class="card-head">
      <div><h2>Data coverage</h2>
        <p class="desc">Which company, platform and file type is loaded, what is missing, and when each was last read.</p></div>
      <span class="pill need">planned</span>
    </div>
  </div>
</main>

<script type="module">
import { createClient } from "https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm";
const SB_URL = "https://bttppihskbfmxwujyztj.supabase.co";
const SB_KEY = "sb_publishable_ooT6WLYpHh6NOVWJBH7ECw_E78_gwqQ";
const sb = createClient(SB_URL, SB_KEY, { auth: { persistSession: true, storageKey: "pd_tracker_auth" } });
const $ = (s) => document.querySelector(s);
const inr = (n) => n == null ? "" : "₹" + Number(n).toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const esc = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

let LAST_ROWS = [];

(async () => {
  const { data: { session } } = await sb.auth.getSession();
  if (!session) { location.href = "/home/?return=%2Freports%2F"; return; }

  // A report is only offered when the data behind it exists. Showing a report
  // that can only answer "nothing found" because a file was never uploaded is
  // worse than not showing it - it reads as a clean bill of health.
  const [{ count: nOrders }, { count: nPayments }] = await Promise.all([
    sb.from("seller_orders").select("id", { count: "exact", head: true }),
    sb.from("seller_payments").select("id", { count: "exact", head: true }),
  ]);

  const pill = $("#pillUnpaid");
  if (!nOrders || !nPayments) {
    pill.className = "pill need";
    pill.textContent = !nOrders && !nPayments ? "needs orders + payments"
                     : !nOrders ? "needs an orders file" : "needs a payments file";
    return;
  }
  $("#cardUnpaid").classList.remove("locked");
  pill.className = "pill ok";
  pill.textContent = "ready";
  $("#unpaidBody").style.display = "";
  runUnpaid();
})();

$("#runUnpaid").addEventListener("click", runUnpaid);
$("#grace").addEventListener("change", runUnpaid);
$("#csvUnpaid").a