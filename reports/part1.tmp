ddEventListener("click", downloadCsv);

async function runUnpaid() {
  const grace = Number($("#grace").value);
  $("#unpaidStatus").innerHTML = '<span class="spin"></span> running';
  $("#unpaidKpis").innerHTML = "";
  $("#unpaidByPlat").innerHTML = "";
  $("#unpaidTableWrap").style.display = "none";

  const { data, error } = await sb.rpc("seller_unpaid_delivered", { _grace_days: grace });
  if (error) {
    $("#unpaidStatus").textContent = "could not run: " + error.message;
    return;
  }
  LAST_ROWS = data || [];
  $("#unpaidStatus").textContent = "";
  render(LAST_ROWS, grace);
}

function render(rows, grace) {
  const total = rows.length;
  const value = rows.reduce((a, r) => a + (Number(r.value) || 0), 0);
  const priced = rows.filter(r => r.value != null).length;
  const oldest = rows.reduce((a, r) => Math.max(a, r.age_days || 0), 0);

  $("#unpaidKpis").innerHTML = `
    <div class="kpi"><div class="n ${total ? "warn" : ""}">${total.toLocaleString("en-IN")}</div><div class="l">orders unpaid</div></div>
    <div class="kpi"><div class="n">${value ? inr(value) : "—"}</div><div class="l">listed value${priced < total ? " (" + priced + " of " + total + " priced)" : ""}</div></div>
    <div class="kpi"><div class="n">${oldest || "—"}</div><div class="l">oldest, days</div></div>`;

  if (!total) {
    $("#unpaidByPlat").innerHTML = `<div class="empty">Nothing delivered more than ${grace} days ago is missing a payment. Every settled line reconciles.</div>`;
    $("#unpaidNote").textContent = "Re-run this after each new payment file — an order can sit here legitimately until the next payout lands.";
    return;
  }

  const by = new Map();
  for (const r of rows) {
    const k = r.platform + "|" + r.company_name;
    const g = by.get(k) || { platform: r.platform, company: r.company_name, n: 0, v: 0, oldest: 0 };
    g.n++; g.v += Number(r.value) || 0; g.oldest = Math.max(g.oldest, r.age_days || 0);
    by.set(k, g);
  }
  const groups = [...by.values()].sort((a, b) => b.n - a.n);
  $("#unpaidByPlat").innerHTML = `<table>
    <tr><th>Platform</th><th>Company</th><th class="num">Orders</th><th class="num">Value</th><th class="num">Oldest</th></tr>
    ${groups.map(g => `<tr><td>${esc(g.platform)}</td><td>${esc(g.company)}</td>
      <td class="num">${g.n}</td><td class="num">${g.v ? inr(g.v) : '<span class="muted">n/a</span>'}</td>
      <td class="num">${g.oldest}d</td></tr>`).join("")}</table>`;

  const show = rows.slice(0, 500);
  $("#unpaidTableWrap").style.display = "";
  $("#unpaidTable").innerHTML = `
    <tr><th>Delivered</th><th class="num">Age</th><th>Platform</th><th>Company</th><th>Order ref</th><th>SKU</th><th class="num">Value</th><th>Dated by</th></tr>
    ${show.map(r => `<tr>
      <td>${esc(r.delivered_on)}</td><td class="num">${r.age_days}d</td>
      <td>${esc(r.platform)}</td><td>${esc(r.company_name)}</td>
      <td>${esc(r.order_ref)}</td><td>${esc(r.sku || "")}</td>
      <td class="num">${r.value != null ? inr(r.value) : '<span class="muted">n/a</span>'}</td>
      <td>${r.dated_by === "delivered" ? "delivery date" : '<span class="muted">order date</span>'}</td>
    </tr>`).join("")}`;

  const estimated = rows.filter(r => r.dated_by !== "delivered").length;
  $("#unpaidNote").innerHTML =
    `Value is the price listed on the order, not what you would receive &mdash; commission, shipping and fees come out of it, so expect to net roughly half.`
    + (estimated ? ` ${estimated} of these have no delivery date in the export, so age is counted from the order date and runs slightly long.` : "")
    + ` Re-run after each new payment file before raising anything with support: a payout landing tomorrow clears these without a ticket.`
    + (show.length < total ? ` Showing the ${show.length} oldest of ${total}; the CSV has all of them.` : "");
}

function downloadCsv() {
  if (!LAST_ROWS.length) return;
  const cols = ["platform", "company_name", "order_ref", "sku", "delivered_on", "age_days", "value", "dated_by"];
  const q = (v) => `"${String(v == null ? "" : v).replace(/"/g, '""')}"`;
  const csv = [cols.join(","), ...LAST_ROWS.map(r => cols.map(c => q(r[c])).join(","))].join("\n");
  const a = document.createElement("a");
  a.href = URL.createObjectURL(new Blob([csv], { type: "text/csv" }));
  a.download = `unpaid-delivered-${new Date().toISOString().slice(0, 10)}.csv`;
  a.click();
  URL.revokeObjectURL(a.href);
}
</script>
</body>
</html>
